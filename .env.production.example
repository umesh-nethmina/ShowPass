# Copy to .env.production (never commit it) and fill in. Used by docker-compose.prod.yml.
DOMAIN=tickets.example.com
POSTGRES_PASSWORD=
# Long random strings, e.g. `openssl rand -base64 48`
JWT_SECRET=
QR_SECRET=
APP_TIMEZONE=Asia/Colombo

PAYMENT_GATEWAY=payhere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
PAYHERE_SANDBOX=false

GOOGLE_CLIENT_ID=

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
MAIL_FROM="ShowPass <tickets@example.com>"

SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
